# Generated by scripts/export_poses_v2.py
# v4 leads in alphaVbeta1 (8W30): PLIP metal + Asn224 gate
# Section 8.5b's filter: a carboxylate oxygen within 3.2 A of the MIDAS metal
# AND a hydrogen-bond donor within 3.5 A of B/224's backbone O.
# The distance monitors below are on the exact atom pairs the filter measured.

# ---- receptor ----
open receptor.pdb
hide atoms
hide cartoons
show #1/A,B cartoons
color #1 gray(70)
transparency #1 60 cartoons

# receptor chains, colored separately
color #1/A light steel blue cartoons
color #1/B rosy brown cartoons

# the MIDAS metal: CA B/501, element CA
show #1/B:501 atoms
style #1/B:501 sphere
color #1/B:501 goldenrod

# the pre-registered donor contact
show #1/B:224 atoms
style #1/B:224 stick
color #1/B:224 cornflower blue atoms
color #1/B:224 byhetero atoms
label #1/B:501|#1/B:224 residues

# a second metal site in reach of the poses: CA B/502
show #1/B:502 atoms
style #1/B:502 sphere
size #1/B:502 atomRadius 0.8
color #1/B:502 goldenrod
label #1/B:502 residues

# pocket context: residues within 4.5 A of any exported pose, measured not listed
show #1/A:119|#1/A:121|#1/A:123|#1/A:148|#1/A:149|#1/A:150|#1/A:154|#1/A:178|#1/A:179|#1/A:215|#1/A:218|#1/B:132|#1/B:133|#1/B:134|#1/B:135|#1/B:177|#1/B:182|#1/B:186|#1/B:187|#1/B:188|#1/B:191|#1/B:223|#1/B:225|#1/B:226|#1/B:227|#1/B:229|#1/B:259|#1/B:260|#1/B:320|#1/B:321 atoms
style #1/A:119|#1/A:121|#1/A:123|#1/A:148|#1/A:149|#1/A:150|#1/A:154|#1/A:178|#1/A:179|#1/A:215|#1/A:218|#1/B:132|#1/B:133|#1/B:134|#1/B:135|#1/B:177|#1/B:182|#1/B:186|#1/B:187|#1/B:188|#1/B:191|#1/B:223|#1/B:225|#1/B:226|#1/B:227|#1/B:229|#1/B:259|#1/B:260|#1/B:320|#1/B:321 stick
size #1/A:119|#1/A:121|#1/A:123|#1/A:148|#1/A:149|#1/A:150|#1/A:154|#1/A:178|#1/A:179|#1/A:215|#1/A:218|#1/B:132|#1/B:133|#1/B:134|#1/B:135|#1/B:177|#1/B:182|#1/B:186|#1/B:187|#1/B:188|#1/B:191|#1/B:223|#1/B:225|#1/B:226|#1/B:227|#1/B:229|#1/B:259|#1/B:260|#1/B:320|#1/B:321 stickRadius 0.06
color #1/A:119|#1/A:121|#1/A:123|#1/A:148|#1/A:149|#1/A:150|#1/A:154|#1/A:178|#1/A:179|#1/A:215|#1/A:218|#1/B:132|#1/B:133|#1/B:134|#1/B:135|#1/B:177|#1/B:182|#1/B:186|#1/B:187|#1/B:188|#1/B:191|#1/B:223|#1/B:225|#1/B:226|#1/B:227|#1/B:229|#1/B:259|#1/B:260|#1/B:320|#1/B:321 gray(55) atoms
color #1/A:119|#1/A:121|#1/A:123|#1/A:148|#1/A:149|#1/A:150|#1/A:154|#1/A:178|#1/A:179|#1/A:215|#1/A:218|#1/B:132|#1/B:133|#1/B:134|#1/B:135|#1/B:177|#1/B:182|#1/B:186|#1/B:187|#1/B:188|#1/B:191|#1/B:223|#1/B:225|#1/B:226|#1/B:227|#1/B:229|#1/B:259|#1/B:260|#1/B:320|#1/B:321 byhetero atoms

# ---- ligand pose(s) ----
# opt_10773  (LEAD)  pose 1  affinity -7.853 kcal/mol
#   CA       2.80 A carboxylate (PASS, cutoff 3.2)
#   donor    3.02 A (PASS, cutoff 3.5)
open opt_10773.pdb
style #2 stick
color #2 orange red
color #2 byhetero

# opt_11266  (LEAD)  pose 1  affinity -7.727 kcal/mol
#   CA       2.76 A carboxylate (PASS, cutoff 3.2)
#   donor    3.09 A (PASS, cutoff 3.5)
open opt_11266.pdb
style #3 stick
color #3 hot pink
color #3 byhetero

# opt_10928  (LEAD)  pose 1  affinity -7.083 kcal/mol
#   CA       2.82 A carboxylate (PASS, cutoff 3.2)
#   donor    3.47 A (PASS, cutoff 3.5)
open opt_10928.pdb
style #4 stick
color #4 dark orange
color #4 byhetero

# gen_11276  (LEAD)  pose 1  affinity -7.208 kcal/mol
#   CA       3.18 A carboxylate (PASS, cutoff 3.2)
#   donor    3.11 A (PASS, cutoff 3.5)
open gen_11276.pdb
style #5 stick
color #5 crimson
color #5 byhetero

# PANEL_PLN-1474  (reference)  pose 1  affinity -6.973 kcal/mol
#   CA       3.14 A carboxylate (PASS, cutoff 3.2)
#   CA       3.01 A nearest O -- NOT a carboxylate, so the geometry gate does not count it
#   donor    4.01 A (FAIL, cutoff 3.5)
open PANEL_PLN-1474.pdb
style #6 stick
color #6 medium purple
color #6 byhetero

# ---- distance monitors ----
# chain is intentionally omitted from each ligand spec so the
# atom name matches regardless of what chain ID the docking output used.
distance #2@O3 #1/B:501@CA color yellow dashes 6 radius 0.06 decimalPlaces 2
distance #2@N2 #1/B:224@O color cyan dashes 6 radius 0.06 decimalPlaces 2
distance #3@O1 #1/B:501@CA color yellow dashes 6 radius 0.06 decimalPlaces 2
distance #3@N1 #1/B:224@O color cyan dashes 6 radius 0.06 decimalPlaces 2
distance #4@O2 #1/B:501@CA color yellow dashes 6 radius 0.06 decimalPlaces 2
distance #4@N1 #1/B:224@O color cyan dashes 6 radius 0.06 decimalPlaces 2
distance #5@O2 #1/B:501@CA color yellow dashes 6 radius 0.06 decimalPlaces 2
distance #5@N2 #1/B:224@O color cyan dashes 6 radius 0.06 decimalPlaces 2
distance #6@O2 #1/B:501@CA color yellow dashes 6 radius 0.06 decimalPlaces 2
distance #6@O1 #1/B:501@CA color orange dashes 3 radius 0.06 decimalPlaces 2
distance #6@N2 #1/B:224@O color cyan dashes 6 radius 0.06 decimalPlaces 2

# ---- view + rendering ----
view #1/B:501 @< 12
lighting soft
graphics silhouettes true
set bgColor white

# receptor  : chain A light steel blue, chain B rosy brown (cartoons)
# CA        : goldenrod sphere (CA B/501); the colour is keyed to the element,
#             so it means the same metal in every view this writes
# CA        : goldenrod sphere (B/502) -- a NEIGHBOURING metal site, not the MIDAS one
# LEAD      : opt_10773 carbons orange red
# LEAD      : opt_11266 carbons hot pink
# LEAD      : opt_10928 carbons dark orange
# LEAD      : gen_11276 carbons crimson
# reference : PANEL_PLN-1474 carbons medium purple
# heteroatoms by element on every ligand (N blue, O red, S yellow)
# yellow dashes = carboxylate to the MIDAS metal (cutoff 3.2 A)
# orange dashes = nearest O/N/S to the metal where that is NOT the carboxylate;
#                 drawn because a ligand can coordinate the MIDAS with another atom,
#                 which the geometry gate does not count
# cyan  dashes  = donor to B/224 backbone O (cutoff 3.5 A)
